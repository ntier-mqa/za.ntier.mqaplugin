<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SOR_LegacyLearnership" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-5678-90ab-cdef-1234567890ab">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SOR_Learnership/nTier_20260619_1.jrdax"/>
	<parameter name="RECORD_ID" class="java.lang.Integer"/>
	<parameter name="RESOURCE_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[SELECT DISTINCT
    TRIM(COALESCE(ca.ZZFIRSTNAME, '') || ' ' || COALESCE(ca.Surname, '')) AS LEARNER_NAME,
    COALESCE(ca.ZZ_ID_PASSPORT_NO, ca.ZZOTHERIDNO) AS ID_NO,
    emp.Name AS EMPLOYER,
    sdp.Name AS PROVIDER,
    Q.ZZSaqaQualificationCode AS REFERENCE_NO,
    LS.ZZLEARNERSHIPTITLE AS QUALIFICATION,
    LS.ZZLEARNERSHIP_ID AS QUALIFICATION_ID,
    ca.ZZLearnerLearnership_ID AS ENROLLMENT_ID,
    NULL AS SIGNATURECHIEF,
    NULL AS SIGNATURESMQA
FROM
    ZZCompletedAssessments_v ca
    LEFT JOIN c_bpartner emp ON ca.ZZ_Employer_ID = emp.c_bpartner_id
    LEFT JOIN c_bpartner sdp ON ca.ZZ_SDP_ID = sdp.c_bpartner_id
    JOIN ZZLearnerLearnership LSHIP ON LSHIP.ZZLearnerLearnership_ID = ca.ZZLearnerLearnership_ID
    JOIN ZZLEARNERSHIP LS ON LS.ZZLEARNERSHIP_ID = LSHIP.ZZLEARNERSHIP_ID
    LEFT JOIN ZZQualification Q ON Q.ZZQualification_ID = LS.ZZQualification_ID
WHERE 
    ca.ZZCompletedAssessments_v_ID = $P{RECORD_ID}]]>
	</queryString>
