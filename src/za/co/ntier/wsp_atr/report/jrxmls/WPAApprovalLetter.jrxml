					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["Dear " + ($P{ApplicantName} != null && !$P{ApplicantName}.isEmpty() ? $P{ApplicantName} : "")]]></textFieldExpression>
			</textField>
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="30" y="113" width="495" height="20" uuid="9c8eb25e-4c5f-4a0b-8d00-4b8c9c9b5d38"/>
