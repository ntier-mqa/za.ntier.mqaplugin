					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["WORKPLACE APPROVAL FOR " + $P{BPName}]]></textFieldExpression>
			</textField>
		</band>
		<band height="20" splitType="Stretch">
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="30" y="0" width="495" height="20" uuid="3d21b452-4753-41c1-8f55-b4618e478546"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font size="11"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<textFieldExpression><![CDATA["The MQA is mandated in terms of section 10 C (i) of the Skills Development Amendment Act (SDA) 37 of 2008 to identify workplaces for practical work experiences.\n\nFurther, the Workplace Based Learning Programme Agreement Regulations for South African Sector Education and Training Authorities (SETAs) aim to formalize the process of registering and managing learning programs that involve work experience.\n\nThis letter serves to confirm a workplace approval for the following site and scope."]]></textFieldExpression>
			</textField>
		</band>
		<band height="30" splitType="Stretch">
			<textField textAdjust="StretchHeight">
				<reportElement positionType="Float" x="30" y="10" width="495" height="20" uuid="f271f8b6-3a7a-4c28-9831-7e87000afef2"/>
				<textElement verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{TitleCreation}]]></textFieldExpression>
			</textField>
		</band>
