				<textElement textAlignment="Justified" markup="styled">
					<font size="11"/>
				</textElement>
				<textFieldExpression><![CDATA["\nThe workplace approval status has been granted as per the above-mentioned scope <style forecolor=\"#FF0000\" isBold=\"true\">including for Candidacy, Internship and Workplace Experiential Learning.</style> Please <style isBold=\"true\" isItalic=\"true\" isUnderline=\"true\">NOTE</style> that the MQA conduct monitoring on the worksite. Furthermore, the workplace approval shall be valid for the duration that is predetermine by MQA or the curriculum registered with the QCTO; and the approval may be revoked on poor delivery or continual non-conformance requirements set by MQA."]]></textFieldExpression>
			</textField>
		</band>
