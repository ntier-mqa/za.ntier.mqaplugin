	<parameter name="P_C_BPartner_ID" class="java.lang.Integer">
		<parameterDescription><![CDATA[Company (Business Partner) to report on]]></parameterDescription>
	</parameter>
	<parameter name="P_DateFrom" class="java.util.Date">
		<parameterDescription><![CDATA[Start of the levy period range]]></parameterDescription>
	</parameter>
	<parameter name="P_DateTo" class="java.util.Date">
		<parameterDescription><![CDATA[End of the levy period range]]></parameterDescription>
	</parameter>
	<parameter name="RESOURCE_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    bp.Name AS company_name,
    bp.Value AS sdl_number,
    lf.ZZ_Year || lf.ZZ_Month AS month_label,
    cy.FiscalYear AS levy_year,
    ABS(lf.zz_Total) AS levy_amount_received,
    ABS(lf.ZZ_MG) AS levy_amount,
    ibl.LineNetAmt AS grant_amount
FROM C_BPartner bp
JOIN ZZ_Monthly_Levy_Files lf ON lf.ZZ_SDL_No = bp.Value
LEFT JOIN C_InvoiceBatchLine ibl ON ibl.C_InvoiceBatchLine_ID = lf.C_InvoiceBatchLine_ID
LEFT JOIN C_Year cy ON cy.C_Year_ID = lf.C_Year_ID
WHERE bp.C_BPartner_ID = $P{P_C_BPartner_ID}
  AND to_date(lf.ZZ_Year || lf.ZZ_Month, 'YYYYMM') BETWEEN $P{P_DateFrom} AND $P{P_DateTo}
ORDER BY lf.ZZ_Year, lf.ZZ_Month]]>
	</queryString>
	<field name="company_name" class="java.lang.String"/>
	<field name="sdl_number" class="java.lang.String"/>
	<field name="month_label" class="java.lang.String"/>
	<field name="levy_year" class="java.lang.String"/>
	<field name="levy_amount_received" class="java.math.BigDecimal"/>
	<field name="levy_amount" class="java.math.BigDecimal"/>
	<field name="grant_amount" class="java.math.BigDecimal"/>
	<variable name="V_TotalReceived" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{levy_amount_received}]]></variableExpression>
	</variable>
	<variable name="V_TotalLevy" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{levy_amount}]]></variableExpression>
	</variable>
	<variable name="V_TotalGrant" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{grant_amount}]]></variableExpression>
	</variable>
