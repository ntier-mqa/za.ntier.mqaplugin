	<style name="ValCell" fontName="SansSerif" fontSize="11"/>
	<parameter name="ZZ_WSP_ATR_Submitted_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[-- Lists EVERY active child organisation of this submission's organisation, not just the
-- consolidated ones. zz_wsp_atr_sub_levy_orgs holds only the children that file their own
-- return (ZZ_Parent_Uploads = 'N'), so driving this table from it hid every child the parent
-- uploads for. Section 1 is a disclosure of the group, so both kinds belong here.
--
-- separate_wsp_atr is the INVERSE of the stored flag: ZZ_Parent_Uploads = 'N' means the child
-- files its own separate WSP-ATR ('Y' here); 'Y' means the parent uploads for it ('N' here).
SELECT DISTINCT
    COALESCE(v.orgname, bp.name, '<Sub Levy Organisation>') AS organisation_name,
    COALESCE(v.zz_sdl_no, bp.zz_sdl_no, '<SDL Number>')     AS sdl_number,
    COALESCE(NULLIF(bp.zzsiccode,''), '<SIC Code>')         AS sic_code,
    CASE WHEN COALESCE(l.zz_parent_uploads, 'N') = 'N' THEN 'Y' ELSE 'N' END AS separate_wsp_atr
FROM adempiere.zz_wsp_atr_submitted s
JOIN adempiere.zzsdforganisation parent_so
  ON parent_so.zzsdforganisation_id = s.zzsdforganisation_id
JOIN adempiere.zzorganisationlinkage l
  ON l.bpartner_parent_id = parent_so.c_bpartner_id
 AND l.isactive = 'Y'
JOIN adempiere.zzsdforganisation child_so
  ON child_so.c_bpartner_id = l.c_bpartner_id
 AND child_so.isactive = 'Y'
 AND child_so.zz_docstatus <> 'UnSdfOrg'
LEFT JOIN adempiere.zzsdforganisation_v v
  ON v.zzsdforganisation_id = child_so.zzsdforganisation_id
LEFT JOIN adempiere.c_bpartner bp
  ON bp.isactive = 'Y'
 AND bp.c_bpartner_id = child_so.c_bpartner_id
WHERE s.zz_wsp_atr_submitted_id = $P{ZZ_WSP_ATR_Submitted_ID}
ORDER BY 1, 2]]>
	</queryString>
	<field name="organisation_name" class="java.lang.String"/>
	<field name="sdl_number" class="java.lang.String"/>
	<field name="sic_code" class="java.lang.String"/>
	<field name="separate_wsp_atr" class="java.lang.String"/>
