	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="RESOURCE_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="AD_User_ID" class="java.lang.Integer"/>
	<parameter name="p_SDP_ID" class="java.lang.Integer"/>
	<parameter name="p_ProgrammeType" class="java.lang.String"/>
	<parameter name="p_DatePrinted" class="java.util.Date"/>
	<parameter name="p_ProgrammeCode" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    'Learnership' as ProgType,
    ll.ZZLearnerLearnership_ID as Record_ID,
    l.ZZFirstName as LearnerName,
    l.Surname as LearnerSurname,
    COALESCE(l.ZZ_ID_Passport_No, l.ZZOtherIDNo) as LearnerIDNo,
    emp.Name as EmployerName,
    lp.ZZLearnershipCode as ProgrammeCode,
    sdp.Name as ProviderName,
    usr.Name as PrintedByUserName,
    q.ZZSaqaQualificationTitle as QualDesc,
    lp.ZZLearnershipTitle as LearnershipTitle,
    (SELECT COALESCE(SUM(ass.ZZCredits), 0) FROM ZZLearnerLearnershipAssessments ass WHERE ass.ZZLearnerLearnership_ID = ll.ZZLearnerLearnership_ID AND ass.IsActive = 'Y' AND ass.ZZAssessmentStatus = 'CO') as CreditsAchieved,
    job.Name as PrintedByUserDesignation
FROM ZZLearnerLearnership ll
JOIN ZZLearner_v l ON ll.ZZLearner_ID = l.ZZLearner_ID
LEFT JOIN C_BPartner emp ON ll.ZZ_Employer_ID = emp.C_BPartner_ID
LEFT JOIN ZZLearnership lp ON ll.ZZLearnership_ID = lp.ZZLearnership_ID
LEFT JOIN ZZQualification q ON lp.ZZQualification_ID = q.ZZQualification_ID
LEFT JOIN C_BPartner sdp ON ll.ZZ_SDP_ID = sdp.C_BPartner_ID
LEFT JOIN AD_User usr ON usr.AD_User_ID = COALESCE(ll.ZZIssueUser_ID, CAST($P{AD_User_ID} AS integer), 0)
LEFT JOIN C_Job job ON usr.C_Job_ID = job.C_Job_ID
WHERE ll.ZZDateOfIssue IS NOT NULL
  AND ll.ZZ_SDP_ID = CAST($P{p_SDP_ID} AS integer)
  AND (CAST($P{p_DatePrinted} AS timestamp) IS NULL OR date_trunc('day', ll.ZZDateOfIssue) = date_trunc('day', CAST($P{p_DatePrinted} AS timestamp)))
  AND (CAST($P{p_ProgrammeCode} AS varchar) IS NULL OR lp.ZZLearnershipCode = CAST($P{p_ProgrammeCode} AS varchar))]]>
	</queryString>
