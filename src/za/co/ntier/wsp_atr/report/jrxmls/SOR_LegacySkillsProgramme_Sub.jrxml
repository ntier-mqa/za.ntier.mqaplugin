	<parameter name="ENROLLMENT_ID" class="java.lang.Integer"/>
	<parameter name="RESOURCE_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[SELECT
    US.ZZSaqaUnitStandardCode AS MODULE_CODE,
    US.ZZSaqaUnitStandardTitle AS MODULE_TITLE,
    US.ZZCREDITS AS CREDIT_VALUE
FROM
    ZZLearnerSkillsProgrammeAssessments ass
    JOIN ZZUNITSTANDARD US ON US.ZZUNITSTANDARD_ID = ass.ZZUNITSTANDARD_ID
WHERE 
    ass.ZZLearnerSkillsProgramme_ID = $P{ENROLLMENT_ID}
    AND ass.ZZAssessmentStatus = 'CO']]>
	</queryString>
	<field name="module_code" class="java.lang.String"/>
	<field name="module_title" class="java.lang.String"/>
	<field name="credit_value" class="java.lang.String"/>
