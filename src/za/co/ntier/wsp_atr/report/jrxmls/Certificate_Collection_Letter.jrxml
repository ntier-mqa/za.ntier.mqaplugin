<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Certificate_Collection_Letter" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8ccce5de-3545-4c96-ac02-4720475eeb67">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PostgreSQL"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="RESOURCE_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="AD_User_ID" class="java.lang.Integer"/>
	<parameter name="p_SDP_ID" class="java.lang.Integer"/>
	<parameter name="p_ProgrammeType" class="java.lang.String"/>
	<parameter name="p_DatePrinted" class="java.util.Date"/>
	<parameter name="p_ProgrammeCode" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    'Learnership' as ProgType,
    ll.ZZLearnerLearnership_ID as Record_ID,
    l.ZZFirstName as LearnerName,
    l.Surname as LearnerSurname,
    COALESCE(l.ZZ_ID_Passport_No, l.ZZOtherIDNo) as LearnerIDNo,
    emp.Name as EmployerName,
    lp.ZZLearnershipCode as ProgrammeCode,
    sdp.Name as ProviderName,
    usr.Name as PrintedByUserName,
    usr.Title as PrintedByUserDesignation
FROM ZZLearnerLearnership ll
JOIN ZZLearner_v l ON ll.ZZLearner_ID = l.ZZLearner_ID
LEFT JOIN C_BPartner emp ON ll.ZZ_Employer_ID = emp.C_BPartner_ID
LEFT JOIN ZZLearnership lp ON ll.ZZLearnership_ID = lp.ZZLearnership_ID
LEFT JOIN C_BPartner sdp ON ll.ZZ_SDP_ID = sdp.C_BPartner_ID
LEFT JOIN AD_User usr ON usr.AD_User_ID = COALESCE(CAST($P{AD_User_ID} AS integer), 0)
WHERE ll.ZZDateOfIssue IS NOT NULL
  AND ll.ZZ_SDP_ID = CAST($P{p_SDP_ID} AS integer)
  AND (CAST($P{p_DatePrinted} AS timestamp) IS NULL OR date_trunc('day', ll.ZZDateOfIssue) = date_trunc('day', CAST($P{p_DatePrinted} AS timestamp)))
  AND (CAST($P{p_ProgrammeCode} AS varchar) IS NULL OR lp.ZZLearnershipCode = CAST($P{p_ProgrammeCode} AS varchar))
  AND 'Learnership' = CAST($P{p_ProgrammeType} AS varchar)

UNION ALL

SELECT 
    'Skills Programme' as ProgType,
    sp.ZZLearnerSkillsProgramme_ID as Record_ID,
    l.ZZFirstName as LearnerName,
    l.Surname as LearnerSurname,
    COALESCE(l.ZZ_ID_Passport_No, l.ZZOtherIDNo) as LearnerIDNo,
    emp.Name as EmployerName,
    p.ZZSkillsProgrammeCode as ProgrammeCode,
    sdp.Name as ProviderName,
    usr.Name as PrintedByUserName,
    usr.Title as PrintedByUserDesignation
FROM ZZLearnerSkillsProgramme sp
JOIN ZZLearner_v l ON sp.ZZLearner_ID = l.ZZLearner_ID
LEFT JOIN C_BPartner emp ON sp.ZZ_Employer_ID = emp.C_BPartner_ID
LEFT JOIN ZZSkillsProgramme p ON sp.ZZSkillsProgramme_ID = p.ZZSkillsProgramme_ID
LEFT JOIN C_BPartner sdp ON sp.ZZ_SDP_ID = sdp.C_BPartner_ID
LEFT JOIN AD_User usr ON usr.AD_User_ID = COALESCE(CAST($P{AD_User_ID} AS integer), 0)
WHERE sp.ZZDateOfIssue IS NOT NULL
  AND sp.ZZ_SDP_ID = CAST($P{p_SDP_ID} AS integer)
  AND (CAST($P{p_DatePrinted} AS timestamp) IS NULL OR date_trunc('day', sp.ZZDateOfIssue) = date_trunc('day', CAST($P{p_DatePrinted} AS timestamp)))
  AND (CAST($P{p_ProgrammeCode} AS varchar) IS NULL OR p.ZZSkillsProgrammeCode = CAST($P{p_ProgrammeCode} AS varchar))
  AND 'Skills Programme' = CAST($P{p_ProgrammeType} AS varchar)]]>
	</queryString>
	<field name="LearnerName" class="java.lang.String"/>
	<field name="LearnerSurname" class="java.lang.String"/>
	<field name="LearnerIDNo" class="java.lang.String"/>
	<field name="EmployerName" class="java.lang.String"/>
	<field name="ProgrammeCode" class="java.lang.String"/>
	<field name="ProviderName" class="java.lang.String"/>
	<field name="PrintedByUserName" class="java.lang.String"/>
	<field name="PrintedByUserDesignation" class="java.lang.String"/>
	<field name="ProgType" class="java.lang.String"/>
