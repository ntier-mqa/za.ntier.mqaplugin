<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Learnership_Collection_Letter" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8ccce5de-3545-4c96-ac02-4720475eeb67">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="nTier_20260804.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="RESOURCE_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["./"]]></defaultValueExpression>
	</parameter>
	<parameter name="AD_User_ID" class="java.lang.Integer"/>
	<parameter name="ZZ_SDP_ID" class="java.lang.Integer"/>
	<parameter name="p_LearnerFirstname" class="java.lang.String"/>
	<parameter name="p_LearnerSurname" class="java.lang.String"/>
	<parameter name="p_LearnerID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    cr.ZZ_CertificateReprints_ID,
    l.ZZFirstName AS LearnerName,
    l.Surname AS LearnerSurname,
    COALESCE(l.ZZ_ID_Passport_No, l.ZZOtherIDNo) AS LearnerIDNo, 
    emp.Name AS EmployerName,
    sdp.Name AS ProviderName,
    COALESCE(prog_ll.ZZLearnershipCode, prog_sp.ZZSkillsProgrammeCode) AS ProgrammeCode,
    COALESCE(prog_ll.ZZLearnershipTitle, prog_sp.ZZSkillsProgrammeTitle) AS ProgrammeDescription,
    COALESCE(ll.ZZDateOfIssue, sp.ZZDateOfIssue) AS DateOfIssue,
    cr.ZZReprintDate AS ReIssueDate,
    req.Name AS RequestedBy,
    job.Name AS Position,
    cr.ZZReIssueReason AS ReasonForReIssue,
    COALESCE(cr.IsCertifiedIDAttached, 'N') AS IsCertifiedIDAttached,
    COALESCE(cr.IsAffidavitAttached, 'N') AS IsAffidavitAttached
FROM (
    SELECT *, ROW_NUMBER() OVER(
        PARTITION BY COALESCE(ZZLearnerLearnership_ID, ZZLearnerSkillsProgramme_ID) 
        ORDER BY ZZReprintDate DESC, Created DESC
    ) as rn
    FROM ZZ_CertificateReprints
) cr
LEFT JOIN ZZLearnerLearnership ll ON cr.ZZLearnerLearnership_ID = ll.ZZLearnerLearnership_ID
LEFT JOIN ZZLearnerSkillsProgramme sp ON cr.ZZLearnerSkillsProgramme_ID = sp.ZZLearnerSkillsProgramme_ID
LEFT JOIN ZZLearner_v l ON l.ZZLearner_ID = COALESCE(ll.ZZLearner_ID, sp.ZZLearner_ID)
LEFT JOIN C_BPartner emp ON emp.C_BPartner_ID = COALESCE(ll.ZZ_Employer_ID, sp.ZZ_Employer_ID)
LEFT JOIN C_BPartner sdp ON sdp.C_BPartner_ID = COALESCE(ll.ZZ_SDP_ID, sp.ZZ_SDP_ID)
LEFT JOIN ZZLearnership prog_ll ON ll.ZZLearnership_ID = prog_ll.ZZLearnership_ID
LEFT JOIN ZZSkillsProgramme prog_sp ON sp.ZZSkillsProgramme_ID = prog_sp.ZZSkillsProgramme_ID
LEFT JOIN AD_User req ON cr.ZZ_RequestedBy_ID = req.AD_User_ID
LEFT JOIN C_Job job ON req.C_Job_ID = job.C_Job_ID
WHERE cr.rn = 1
  AND (CAST($P{ZZ_SDP_ID} AS integer) IS NULL OR sdp.C_BPartner_ID = CAST($P{ZZ_SDP_ID} AS integer))
  AND (CAST($P{p_LearnerFirstname} AS varchar) IS NULL OR l.ZZFirstName ILIKE '%' || CAST($P{p_LearnerFirstname} AS varchar) || '%')
  AND (CAST($P{p_LearnerSurname} AS varchar) IS NULL OR l.Surname ILIKE '%' || CAST($P{p_LearnerSurname} AS varchar) || '%')
  AND (CAST($P{p_LearnerID} AS varchar) IS NULL OR COALESCE(l.ZZ_ID_Passport_No, l.ZZOtherIDNo) ILIKE '%' || CAST($P{p_LearnerID} AS varchar) || '%')]]>
	</queryString>
